# Configuración general de la aplicación
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=clave-secreta-super-segura-uninorte-2026

# Conexión a Base de Datos PostgreSQL
# Formato: postgresql://<usuario>:<contraseña>@localhost:5432/<nombre_bd>
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=serviciotecnico_db

# Fallback opcional a SQLite si no se conecta a Postgres (True / False)
USE_SQLITE_FALLBACK=False
